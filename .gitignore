# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example

# Data — repos stay light; the full dataset is re-downloaded by ingest.py.
# Exception: the tiny slice in data/olist_sample/ IS committed so CI and
# `docker compose up` run the whole pipeline with no credentials.
data/*
!data/olist_sample/
data/olist_sample/*
raw/
bronze/
*.parquet
*.ndjson
*.zip
*.csv
!dbt/seeds/*.csv
!data/olist_sample/*.csv

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Terraform
terraform/.terraform/
*.tfstate
*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example

# Great Expectations
gx/uncommitted/

